-        if (event.target === modal) {
-            closeModal();
-        }
-    });
-
-    // Close on Escape for keyboard users.
-    document.addEventListener('keydown', (event) => {
-        if (event.key === 'Escape' && !modal.hidden) {
-            closeModal();
-        }
-    });
