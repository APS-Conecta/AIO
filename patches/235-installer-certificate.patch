@@ -3,6 +3,11 @@
 
     auto_https disable_redirects
 
+    # APS (R22): start.sh writes the install's address here when it serves the installer's
+    # certificate. A client reaching the suite by IP sends no SNI, and Caddy then picks a
+    # certificate by the local address, which inside Docker is the container's: none matches.
+    # default_sni placeholder
+
     storage file_system {
         root /mnt/data/caddy
     }
@@ -29,9 +34,9 @@
     }
 }
 
-https://{$ADDITIONAL_TRUSTED_DOMAIN}:443,
-http://{$APACHE_HOST}.nextcloud-aio:23973, # For Collabora callback and WOPI requests, see containers.json
-{$PROTOCOL}://{$NC_DOMAIN}:{$APACHE_PORT} {
+# APS (R22): the routes live in a snippet so the internal plain-http address and the site are
+# separate blocks — a site serving a file certificate cannot share a block with an http address.
+(aps_routes) {
     header {
         Strict-Transport-Security max-age=31536000;
 
@@ -100,14 +105,18 @@ http://{$APACHE_HOST}.nextcloud-aio:23973, # For Collabora callback and WOPI req
     }
     redir /.well-known/carddav /remote.php/dav/ 301
     redir /.well-known/caldav /remote.php/dav/ 301
+}
 
-    # TLS options
-    tls {
-        issuer acme {
-            profile shortlived
-            # Disable HTTP challenge because that would require port 80, which we don't get (it's exposed to the mastercontainer).
-            # This container by default only exposes port 443 if not configured otherwise via APACHE_PORT.
-            disable_http_challenge
-        }
-    }
+http://{$APACHE_HOST}.nextcloud-aio:23973 { # For Collabora callback and WOPI requests, see containers.json
+    import aps_routes
+}
+
+https://{$ADDITIONAL_TRUSTED_DOMAIN}:443,
+{$PROTOCOL}://{$NC_DOMAIN}:{$APACHE_PORT} {
+    import aps_routes
+
+    # TLS options: start.sh writes the installer's certificate here when /aps-tls holds one (an
+    # install by IP, R22), else upstream's ACME issuer (shortlived, no HTTP challenge: port 80 is
+    # the mastercontainer's)
+    # tls placeholder
 }
diff --git a/Containers/apache/start.sh b/Containers/apache/start.sh
index 35bf5046..96771324 100644
--- a/Containers/apache/start.sh
+++ b/Containers/apache/start.sh
@@ -82,6 +82,21 @@ if [ -z "$ADDITIONAL_TRUSTED_DOMAIN" ]; then
 fi
 echo "$CADDYFILE" > /tmp/Caddyfile
 
+# APS (R22): the installer's own certificate when one is mounted (an install by IP), else upstream's
+# ACME issuer. Only on 443: behind a reverse proxy (APACHE_PORT != 443) the site is plain http.
+if [ "$APACHE_PORT" = '443' ] && [ -r /aps-tls/tls.crt ] && [ -r /aps-tls/tls.key ]; then
+    TLS_STANZA='tls /aps-tls/tls.crt /aps-tls/tls.key'
+    DEFAULT_SNI="default_sni $NC_DOMAIN"
+else
+    TLS_STANZA='tls {\n\t\tissuer acme {\n\t\t\tprofile shortlived\n\t\t\tdisable_http_challenge\n\t\t}\n\t}'
+    DEFAULT_SNI=''
+    if [ -d /aps-tls ]; then
+        echo "APS_TLS_DIR is mounted, but its tls.crt and tls.key are not both readable by uid $(id -u) or APACHE_PORT is not 443: the ACME issuer stays"
+    fi
+fi
+CADDYFILE="$(sed -e "s|# tls placeholder|$TLS_STANZA|" -e "s|# default_sni placeholder|$DEFAULT_SNI|" /tmp/Caddyfile)"
+echo "$CADDYFILE" > /tmp/Caddyfile
+
 # Fix the Caddyfile format
 caddy fmt --overwrite /tmp/Caddyfile
 
