     display: inline-block;
 }
 
+/* Phones: the setup/login card flows in the page instead of floating at a fixed 500px (a flow-root
+   wrapper so its margin does not collapse into a band), the header's padding stays on the screen,
+   and the containers page keeps its text column (the 50px gutters ate a third of a 360px screen). */
+@media only screen and (max-width: 640px) {
+    :root {
+        --main-padding: 16px;
+    }
+    header {
+        box-sizing: border-box;
+    }
+    .wrapper {
+        position: static;
+        overflow: visible;
+        width: auto;
+        min-width: 0;
+        display: flow-root;
+    }
+    .login {
+        position: static;
+        transform: none;
+        width: auto;
+        margin: 16px;
+        padding: 24px 16px;
+    }
+}
